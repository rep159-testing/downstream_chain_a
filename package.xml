<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>downstream_chain_a</name>
  <version>0.1.0</version>
  <description>
    Package of the extendablechain distribution for REP-159 test harness:
    consumes downstream_bin_a through chained binary_import extensions.
  </description>
  <maintainer email="federico.rossi@creativa77.com.ar">Federico Rossi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <depend>downstream_bin_a</depend>

  <!-- Google Test dependency for testing chained resolution -->
  <build_depend>gtest</build_depend>
  <test_depend>gtest</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
